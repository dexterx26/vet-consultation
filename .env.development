# ==============================================================================
# ENVIRONMENT: DEVELOPMENT (LOCAL LAPTOP / PC)
# Database: SQLite (database/database.sqlite)
# Reverb: Local WebSocket Server (http://localhost:8001)
# ==============================================================================

APP_NAME="VetTeleconsult (Dev)"
APP_ENV=local
APP_KEY=base64:0VjzKE18ZOfvr2aTq6bBnD913P/xLWB8HQmFaGXg7t0=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging (Local file log in storage/logs/laravel.log)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION: SQLite (Zero configuration local file)
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# State Storage (Using local SQLite database tables)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# REAL-TIME WEBSOCKETS (Laravel Reverb - Local HTTP/WS Mode)
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=vet_teleconsult_app
REVERB_APP_KEY=vet_teleconsult_key
REVERB_APP_SECRET=vet_teleconsult_secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8001
REVERB_SERVER_PORT=8001
REVERB_SCHEME=http

# Frontend Vite Reverb Variables (Used by resources/js/echo.js)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Mail (Log to storage/logs/laravel.log during development)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="dev@vetteleconsult.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
