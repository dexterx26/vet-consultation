APP_NAME="Veterinary Teleconsultation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Configuration
# Local: sqlite / mysql
# Render Production: pgsql (Render injects DATABASE_URL automatically)
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_URL=
# DATABASE_URL=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=vet_consultation
# DB_USERNAME=vet_user
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Laravel Reverb (WebSockets)
# Local: host localhost, port 8001, scheme http
# Render: host your-app.onrender.com, port 443, scheme https
# -----------------------------------------------------------------------------
REVERB_APP_ID=vet_teleconsult_app
REVERB_APP_KEY=vet_teleconsult_key
REVERB_APP_SECRET=vet_teleconsult_secret
REVERB_HOST="localhost"
REVERB_PORT=8001
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8001
REVERB_SCHEME=http

# Internal broadcast connection within Docker container
REVERB_API_HOST=127.0.0.1
REVERB_API_PORT=8080
REVERB_API_SCHEME=http

# Frontend Vite Reverb Variables
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@vetconsult.com"
MAIL_FROM_NAME="${APP_NAME}"

# Container deployment switches
RUN_MIGRATIONS=true
RUN_SEEDER=false
