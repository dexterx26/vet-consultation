# ==============================================================================
# ENVIRONMENT: PRODUCTION (RENDER / POSTGRESQL / DOCKER)
# Database: PostgreSQL (DATABASE_URL or individual parameters)
# Reverb: Reverse-proxied via Nginx / HTTPS / WSS port 443
# ==============================================================================

APP_NAME="Veterinary Teleconsultation"
APP_ENV=production
APP_KEY=base64:0VjzKE18ZOfvr2aTq6bBnD913P/xLWB8HQmFaGXg7t0=
APP_DEBUG=false
APP_URL=https://vet-consultation-app.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging (Streams to stderr for Render / Docker cloud log monitoring)
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION: PostgreSQL (Managed Database)
# Note: Render automatically injects DATABASE_URL from your PostgreSQL service.
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql

# If using a direct connection string (e.g. Render, Supabase, Neon):
DATABASE_URL=

# If using individual host/user credentials:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vet_consultation
DB_USERNAME=vet_user
DB_PASSWORD=
DB_SSLMODE=prefer

# State Storage (Using PostgreSQL database tables)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# REAL-TIME WEBSOCKETS (Laravel Reverb - Production HTTPS/WSS Mode)
# Nginx proxies public port 443 traffic internally to Reverb on 127.0.0.1:8080
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=vet_teleconsult_app
REVERB_APP_KEY=vet_teleconsult_key
REVERB_APP_SECRET=vet_teleconsult_secret

# Internal Reverb listener within Docker container
REVERB_SERVER_HOST="127.0.0.1"
REVERB_SERVER_PORT=8080

# Public-facing Reverb connection (Clients connect over standard HTTPS/WSS port 443)
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https

# Internal PHP backend event dispatching to Reverb
REVERB_API_HOST="127.0.0.1"
REVERB_API_PORT=8080
REVERB_API_SCHEME=http

# Frontend Vite Reverb Variables
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=
VITE_REVERB_PORT="443"
VITE_REVERB_SCHEME="https"

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@vetteleconsult.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
